{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": "{src,data}/**"
      }
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "src": "/analytics/(.*)", "dest": "/api/index.py" },
    { "src": "/docs", "dest": "/api/index.py" },
    { "src": "/openapi.json", "dest": "/api/index.py" },
    { "src": "/favicon.ico", "dest": "/frontend/favicon.ico" },
    { "src": "/favicon-16x16.png", "dest": "/frontend/favicon-16x16.png" },
    { "src": "/favicon-32x32.png", "dest": "/frontend/favicon-32x32.png" },
    { "src": "/apple-touch-icon.png", "dest": "/frontend/apple-touch-icon.png" },
    { "src": "/css/(.*)", "dest": "/frontend/css/$1" },
    { "src": "/js/(.*)", "dest": "/frontend/js/$1" },
    { "src": "/([^/]+\\.html)", "dest": "/frontend/$1" },
    { "src": "/frontend/?", "dest": "/frontend/index.html" },
    { "src": "/frontend/(.*)", "dest": "/frontend/$1" },
    { "src": "/", "dest": "/frontend/events.html" }
  ]
}
